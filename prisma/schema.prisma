datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StartupStage {
  IDEA
  VALIDATION
  MVP
  LAUNCH
  TRACTION
  GROWTH
  FUNDING
  SCALE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvestorStage {
  IDENTIFIED
  CONTACTED
  MEETING_SCHEDULED
  IN_DISCUSSION
  TERM_SHEET
  CLOSED
  PASSED
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String?
  avatarUrl    String?
  role         String?
  experience   String?
  location     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  OrgMembership[]
  tasks        Task[]          @relation("AssigneeTasks")
  posts        Post[]
  comments     Comment[]
  auditLogs    AuditLog[]

  @@index([email])
}

model Organization {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  description      String?
  industry         String?
  businessModel    String?
  targetCustomers  String?
  geographicMarket String?
  stage            StartupStage    @default(IDEA)
  teamSize         Int             @default(1)
  productStatus    String?
  revenue          Float           @default(0)
  fundingHistory   String?
  isRegistered     Boolean         @default(false)
  customerCount    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  memberships      OrgMembership[]
  projects         Project[]
  tasks            Task[]
  milestones       Milestone[]
  goals            Goal[]
  transactions     Transaction[]
  investors        Investor[]
  documents        Document[]
  conversations    AIConversation[]
  auditLogs        AuditLog[]
}

model OrgMembership {
  id        String       @id @default(uuid())
  userId    String
  orgId     String
  role      MemberRole   @default(MEMBER)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Project {
  id                 String       @id @default(uuid())
  orgId              String
  name               String
  description        String?
  status             String       @default("ACTIVE")
  taskCount          Int          @default(0)
  completedTaskCount Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks              Task[]

  @@index([orgId])
}

model Task {
  id          String       @id @default(uuid())
  orgId       String
  projectId   String?
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("AssigneeTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([status])
}

model Milestone {
  id          String       @id @default(uuid())
  orgId       String
  title       String
  description String?
  stage       StartupStage
  targetDate  DateTime?
  completedAt DateTime?
  isCompleted Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Goal {
  id          String       @id @default(uuid())
  orgId       String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int          @default(0)
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Transaction {
  id          String          @id @default(uuid())
  orgId       String
  type        TransactionType
  amount      Float
  category    String
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([date])
}

model Opportunity {
  id                      String       @id @default(uuid())
  name                    String
  provider                String
  category                String
  description             String
  benefits                String[]
  eligibilityRequirements String[]
  requiredDocuments       String[]
  eligibleStages          String[]
  eligibleIndustries      String[]
  eligibleLocations       String[]
  applicationDeadline     String?
  officialSourceUrl       String?
  lastVerifiedDate        String?
  status                  String       @default("ACTIVE")
  createdAt               DateTime     @default(now())
}

model Investor {
  id               String        @id @default(uuid())
  orgId            String
  name             String
  firm             String?
  stage            String?
  sectors          String[]
  ticketSize       String?
  contactEmail     String?
  dealStage        InvestorStage @default(IDENTIFIED)
  notes            String?
  lastContactDate  DateTime?
  nextFollowUpDate DateTime?
  createdAt        DateTime      @default(now())
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AIConversation {
  id        String             @id @default(uuid())
  orgId     String
  userId    String
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  proposals AIActionProposal[]

  @@index([orgId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIActionProposal {
  id             String         @id @default(uuid())
  conversationId String
  toolName       String
  arguments      Json
  description    String
  status         ActionStatus   @default(PENDING)
  result         Json?
  createdAt      DateTime       @default(now())
  executedAt     DateTime?
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Post {
  id            String    @id @default(uuid())
  authorId      String
  title         String
  content       String
  topic         String?
  commentCount  Int       @default(0)
  reactionCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@index([authorId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Document {
  id         String       @id @default(uuid())
  orgId      String
  name       String
  category   String
  size       String
  url        String
  uploadedAt DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditLog {
  id        String       @id @default(uuid())
  orgId     String
  userId    String
  action    String
  entity    String
  details   String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}
